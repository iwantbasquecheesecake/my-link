rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 헬퍼 함수 (Helper Functions)
    // ==========================================

    // 1. 로그인 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. 요청자가 해당 리소스의 소유자(본인)인지 확인
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 3. 비로그인/방문자가 링크 클릭 수만 증가시키는 요청인지 검증
    // - 변경되는 필드가 오직 'clickCount'와 'updatedAt'이어야 함
    // - clickCount는 기존 값에서 1만 증가해야 함
    function isClickCountIncrement() {
      let diff = request.resource.data.diff(resource.data);
      return diff.affectedKeys().hasOnly(['clickCount', 'updatedAt'])
        && request.resource.data.clickCount == resource.data.clickCount + 1;
    }

    // ==========================================
    // 1. 사용자 메인 문서 (users/{userId})
    // ==========================================
    match /users/{userId} {
      // 프로필 페이지 조회를 위해 누구나 읽기 가능
      allow read: if true;
      // 본인만 생성, 수정, 삭제 가능
      allow create, update, delete: if isOwner(userId);

      // ==========================================
      // 2. 사용자 프로필 서브컬렉션 (users/{userId}/profile/{docId})
      // ==========================================
      match /profile/{docId} {
        // 프로필 정보는 공개 페이지에서 누구나 조회 가능
        allow read: if true;
        // 본인만 프로필 정보 저장 및 수정 가능
        allow create, update, delete: if isOwner(userId);
      }

      // ==========================================
      // 3. 사용자 링크 서브컬렉션 (users/{userId}/links/{linkId})
      // ==========================================
      match /links/{linkId} {
        // 공개 프로필 링크 목록은 누구나 조회 가능
        allow read: if true;

        // 링크 추가 및 삭제는 본인만 가능
        allow create, delete: if isOwner(userId);

        // 링크 수정: 본인은 전체 수정 가능, 타인/방문자는 '클릭 카운트 1 증가'만 가능
        allow update: if isOwner(userId) || isClickCountIncrement();
      }
    }

    // ==========================================
    // 4. 고유 URL 슬러그 / ID 중복 확인 레지스트리 (displayNames, usernames)
    // ==========================================
    // /[displayName] 라우팅 및 중복 확인을 위해 필요
    match /displayNames/{displayName} {
      // 주소 사용 가능 여부 중복 체크 및 조회는 누구나 가능
      allow read: if true;

      // 새 주소 등록: 로그인된 사용자이며, 저장할 데이터의 uid가 본인이어야 함
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;

      // 주소 변경/삭제: 기존 등록자 본인만 수정 및 삭제 가능
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ==========================================
    // 기본 차단 규칙 (Default Deny)
    // 명시되지 않은 모든 경로는 읽기/쓰기 차단
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
