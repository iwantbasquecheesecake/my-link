rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 헬퍼 함수 (Helper Functions)
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 비로그인/방문자가 링크 클릭 수만 올리는 요청인지 검증
    function isClickCountIncrement() {
      let diff = request.resource.data.diff(resource.data);
      return diff.affectedKeys().hasOnly(['clickCount', 'updatedAt'])
        && request.resource.data.clickCount == resource.data.clickCount + 1;
    }

    // ==========================================
    // 1. 사용자 메인 문서 (users/{userId})
    // ==========================================
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);

      // 2. 프로필 정보 (users/{userId}/profile/{docId})
      match /profile/{docId} {
        allow read: if true;
        allow create, update, delete: if isOwner(userId);
      }

      // 3. 링크 목록 (users/{userId}/links/{linkId})
      match /links/{linkId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
        allow update: if isOwner(userId) || isClickCountIncrement();
      }
    }

    // ==========================================
    // 4. 고유 URL / 디스플레이 네임 중복 확인 (displayNames)
    // ==========================================
    match /displayNames/{displayName} {
      allow read: if true;

      // 🔒 변경점: !('email' in request.resource.data) 조건 추가
      // (만약 누군가 이메일을 포함해서 등록하려 하면 DB 차원에서 거부)
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && !('email' in request.resource.data)
                    && !exists(/databases/$(database)/documents/displayNames/$(displayName));

      allow update, delete: if isAuthenticated()
                            && resource.data.uid == request.auth.uid;
    }

    // 닉네임 중복 방지 컬렉션 (usernames)
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && !('email' in request.resource.data)
                    && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if isAuthenticated()
                            && resource.data.uid == request.auth.uid;
    }

    // ==========================================
    // 기본 차단 규칙 (Default Deny)
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
